# Application
PORT=3000

# AI Provider Configuration
# Options: mini, openrouter, groq, ollama, docker
AI_PROVIDER=mini

# Local AI Backend URL (for docker provider)
LOCAL_AI_BASE_URL=http://host.docker.internal:12434/engines/v1

# Models
MINI_MODEL=phi3:mini
LOCAL_MODEL=gemma2:2b

# PostHog Analytics (optional)
PUBLIC_POSTHOG_PROJECT_TOKEN=

# Supabase (optional)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
