{
	"name": "obstetrascroll",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "SvelteKit proof of concept para generar reels revisados para parteras y obstétricas.",
	"packageManager": "pnpm@10.33.2",
	"engines": {
		"node": ">=20.10"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "biome check .",
		"format": "biome format --write .",
		"media:audio": "node scripts/generate-elevenlabs-audio.mjs",
		"media:trim": "/Users/jonathangadeaharder/Documents/projects/AIServices/.venv/bin/python scripts/trim_openers.py",
		"media:all": "/Users/jonathangadeaharder/Documents/projects/AIServices/.venv/bin/python scripts/build_all_reels.py",
		"test": "vitest run",
		"test:watch": "vitest",
		"prepare": "husky"
	},
	"dependencies": {
		"@fontsource-variable/jetbrains-mono": "^5.2.8",
		"@fontsource-variable/newsreader": "^5.2.8",
		"devalue": "5.8.1",
		"lucide-svelte": "^1.0.1",
		"zod": "^3.24.1"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.11.3",
		"@biomejs/biome": "^1.9.4",
		"@commitlint/cli": "^21.0.1",
		"@commitlint/config-conventional": "^21.0.1",
		"@playwright/test": "^1.60.0",
		"@stryker-mutator/core": "^9.6.1",
		"@stryker-mutator/vitest-runner": "^9.6.1",
		"@sveltejs/adapter-node": "^5.2.9",
		"@sveltejs/kit": "^2.11.1",
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.3.1",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^22.10.2",
		"@vitest/coverage-v8": "^3.2.4",
		"husky": "^9.1.7",
		"jsdom": "^25.0.1",
		"lint-staged": "^17.0.4",
		"msw": "^2.14.6",
		"svelte": "^5.15.0",
		"svelte-check": "^4.1.1",
		"tsx": "^4.22.0",
		"typescript": "^5.7.2",
		"vite": "^6.0.5",
		"vitest": "^3.2.4"
	},
	"lint-staged": {
		"src/**/*.{js,ts,svelte}": [
			"pnpm exec biome check --write --unsafe",
			"pnpm exec biome format --write"
		],
		"src/**/*.{json,css,md}": [
			"pnpm exec biome format --write"
		]
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@biomejs/biome",
			"esbuild"
		]
	}
}
