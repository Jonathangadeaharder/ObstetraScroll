{
	"$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
	"vcs": {
		"enabled": false
	},
	"files": {
		"include": ["src/**"],
		"ignore": [".svelte-kit"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"correctness": {
				"noConstAssign": "off"
			},
			"style": {
				"useConst": "off"
			}
		}
	}
}
