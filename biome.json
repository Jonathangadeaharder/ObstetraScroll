{
	"$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
	"vcs": {
		"enabled": false
	},
	"files": {
		"include": ["src"],
		"ignore": [
			".svelte-kit",
			"build",
			"node_modules",
			".venv",
			"pnpm-lock.yaml",
			"static/generated-media",
			"coverage"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"correctness": {
				"noConstAssign": "off"
			},
			"style": {
				"useConst": "off"
			}
		}
	}
}
